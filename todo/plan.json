{
  "title": "Wobble implementation plan",
  "acceptance": "Every section is stamped, pwsh scripts/check.ps1 -EndToEnd passes on the attached Windows host, and CI is green on main.",
  "phases": {
    "0": "Repository and tooling",
    "1": "Raw CD model and reads",
    "2": "CD writing",
    "3": "DVD read and write",
    "4": "Blu-ray read and write",
    "5": "Fault injection",
    "6": "Profiles and capture",
    "7": "Control interface and release",
    "99": "Manual, operator only"
  },
  "needs": ["windows-host", "display-session", "attended", "owner-decision", "third-party", "operator", "iscsi-initiator", "optical-drive"],
  "probes": {
    "iscsi-initiator": ["pwsh", "-NoProfile", "-Command", "if (Get-IscsiSession | Where-Object TargetNodeAddress -eq 'iqn.2026-11.test.wobble:drive0') { exit 0 } exit 1"],
    "optical-drive": ["pwsh", "-NoProfile", "-Command", "if (Get-CimInstance Win32_CDROMDrive | Where-Object Caption -notlike 'WOBBLE*') { exit 0 } exit 1"]
  }
}
